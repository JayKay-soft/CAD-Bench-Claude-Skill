# Build output -- generated by running a model, never something to commit
*.stl
*.step
*.stp
*.3mf

# Bench hand-off state (written by the CAD Bench page's read-back step)
models/*.params.json

# Scratch models/recipes created while testing scripts/new_part.py
# (rename and commit intentionally-kept ones instead of leaving the default name)
models/*.recipe.js

# Python
__pycache__/
*.pyc
*.pyo

# venvs (see SKILL.md -- the venv is created locally, never checked in)
.venv/
venv/
*-venv/

# OS cruft
.DS_Store
Thumbs.db
